SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (default is SQLite, set to postgres for production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@localhost:5432/tenderflow

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Find a Tender Service API
FIND_TENDER_API_BASE_URL=https://www.find-tender.service.gov.uk/api/1.0
FIND_TENDER_API_KEY=

# Media files
MEDIA_ROOT=media/
MEDIA_URL=/media/

ANTHROPIC_API_KEY=

# Background tasks backend (default: ImmediateBackend runs tasks synchronously in-process)
# Swap for a queue-backed backend in production, e.g. django-tasks-rq or django-db-tasks
APP_URL=https://your-app-domain.com

DJANGO_TASKS_BACKEND=django.tasks.backends.immediate.ImmediateBackend

# Celery (used by the celery-worker/celery-beat services to fetch tenders every 30 min)
# In docker-compose these default to redis://redis:6379/0 (the "redis" service hostname).
# For local (non-Docker) dev, point at a locally running Redis instead:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Port 587 + EMAIL_USE_TLS=True  → STARTTLS (Gmail, most providers)
# Port 465 + EMAIL_USE_SSL=True  → SSL/TLS  (ZeptoMail, some providers)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@tenderflow.ai